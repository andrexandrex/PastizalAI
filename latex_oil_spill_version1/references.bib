@article{zhangNovelWinterWheat2025,
  title = {A Novel Winter Wheat Yield Prediction Framework Using Fused Spatial–Temporal-Spectral ({{STS}}) Information from {{Sentinel-2}} and {{Landsat}} 8 via Improved {{Pix2Pix}} Network},
  author = {Zhang, Haiyang and Zhang, Yao and Tong, Fanghui and Li, Minzan},
  date = {2025-04},
  journaltitle = {Computers and Electronics in Agriculture},
  shortjournal = {Computers and Electronics in Agriculture},
  volume = {231},
  pages = {109982},
  issn = {01681699},
  doi = {10.1016/j.compag.2025.109982},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0168169925000882},
  urldate = {2025-03-17},
  abstract = {Accurately predicting winter wheat yield is essential for optimizing agricultural production and safeguarding national food security. Remote sensing technology offers an efficient method for acquiring large-scale, multitemporal vegetation data, providing robust support for winter wheat yield prediction. However, the revisit cycle and climatic conditions of single satellites often limit the availability of reliable information, thus restricting the accuracy of crop yield prediction. To address this issue, this paper proposed a novel spatial–temporal-spectral (STS) information fusion framework based on the improved Pix2Pix network. The framework converted Landsat 8 (L8) images into Sentinel-2-like (S2-like) images, which were then merged with the original Sentinel-2 (S2) images to generate a fused dataset with richer STS information. In addition, this proposed method could generate and fill in the three red-edge bands lacking in L8 images to improve the abundance of band information in the fused images. Based on the enriched STS features of the fused images, the winter wheat yield was estimated through the selected vegetation index (VI) time series derived from fused images, and various experimental validations were carried out. The experimental results show that the proposed STS information fusion framework based on the improved Pix2Pix can generated images that were very close to the reference images. Among seven vegetation indices (VIs), the Chlorophyll Index Red Edge (CIred-edge) time series can better describe the crop growth process, particularly detecting subtle differences in crop canopy at medium-to-high vegetation densities. In terms of yield forecasting, from 2019 to 2021, the winter wheat yield prediction accuracy reached its best performance using the random forest (RF) algorithm based on the enriched CIred-edge time series. The R2 values were 0.60, 0.59, and 0.66 and the RMSE values were 0.61, 0.72, and 0.61 t/ha, respectively. Moreover, it is worth noting that the proposed method can predict winter wheat yield approximately 50 days before harvest, which was significantly earlier than traditional methods. Finally, compared to single S2 data, the fused data improved the R2 values for yield estimation by 0.19, 0.14, and 0.11, and decreased the RMSE values by 0.23, 0.16, and 0.31 t/ha for the years 2019–2021, respectively. Overall, the proposed method provides a promising approach to accurately predict winter wheat yield and has potential applications in agricultural production and food security.},
  langid = {english},
  file = {C:\Users\user\Zotero\storage\6QN6LXUE\Zhang et al. - 2025 - A novel winter wheat yield prediction framework using fused spatial–temporal-spectral (STS) informat.pdf}
}

