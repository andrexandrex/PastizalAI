@online{jadonRealDriveSimRealisticMultiModal2025,
  title = {{{RealDriveSim}}: {{A Realistic Multi-Modal Multi-Task Synthetic Dataset}} for {{Autonomous Driving}}},
  shorttitle = {{{RealDriveSim}}},
  author = {Jadon, Arpit and Wang, Haoran and Thomas, Phillip and Stanley, Michael and Cibik, S. Nathaniel and Laurat, Rachel and Maher, Omar and Hoyer, Lukas and Unal, Ozan and Dai, Dengxin},
